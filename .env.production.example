# ==============================================================================
# Production Environment Configuration Template
# English Reading Platform - EC2 Deployment (APP_ROLE=all)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container & Deployment Topology
# ------------------------------------------------------------------------------
APP_DOMAIN=reading.example.com
IMAGE_TAG=latest
BACKEND_IMAGE=english-reading-backend
APP_ROLE=all
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Host and Container Storage Paths
# ------------------------------------------------------------------------------
# HOST_DOCUMENT_STORAGE_ROOT is mounted into /data/english-reading in container.
# Covers are persisted in $DOCUMENT_STORAGE_ROOT/documents/
# Ephemeral import chunks are staged in $DOCUMENT_STORAGE_ROOT/staging/
HOST_DOCUMENT_STORAGE_ROOT=/var/lib/english-reading
DOCUMENT_STORAGE_ROOT=/data/english-reading

# ------------------------------------------------------------------------------
# 3. Database (Amazon RDS PostgreSQL)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/<dbname>
DB_USERNAME=english_user
DB_PASSWORD=<strong-random-db-password>
DB_MAXIMUM_POOL_SIZE=10
DB_MINIMUM_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ------------------------------------------------------------------------------
# 4. Security & JWT
# ------------------------------------------------------------------------------
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=<generate-at-least-32-chars-random-secret>
JWT_EXPIRATION=3600s

# ------------------------------------------------------------------------------
# 5. AWS Document Object Storage (S3)
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_PROVIDER=S3
DOCUMENT_STORAGE_S3_BUCKET=english-reading-documents-<account-id>-us-east-1
DOCUMENT_STORAGE_S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. AWS SQS Document Import Queue & Worker
# ------------------------------------------------------------------------------
DOCUMENT_IMPORT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/english-reading-document-import-queue
DOCUMENT_IMPORT_QUEUE_REGION=us-east-1
DOCUMENT_IMPORT_WORKER_ENABLED=true
DOCUMENT_IMPORT_WORKER_AUTO_STARTUP=true
DOCUMENT_IMPORT_WORKER_WAIT_TIME_SECONDS=20
DOCUMENT_IMPORT_WORKER_VISIBILITY_TIMEOUT_SECONDS=60
DOCUMENT_IMPORT_WORKER_MAX_MESSAGES=1
DOCUMENT_IMPORT_WORKER_POLL_DELAY=1s
DOCUMENT_IMPORT_WORKER_ERROR_BACKOFF=5s
DOCUMENT_IMPORT_WORKER_LEASE_DURATION=60s
DOCUMENT_IMPORT_WORKER_HEARTBEAT_INTERVAL=20s
DOCUMENT_IMPORT_WORKER_STAGING_CLEANUP_AGE=24h

# ------------------------------------------------------------------------------
# 7. Document Import Outbox Publisher
# ------------------------------------------------------------------------------
DOCUMENT_IMPORT_OUTBOX_ENABLED=true
DOCUMENT_IMPORT_OUTBOX_BATCH_SIZE=10
DOCUMENT_IMPORT_OUTBOX_LOCK_DURATION=5m
DOCUMENT_IMPORT_OUTBOX_RETRY_BACKOFF=30s
DOCUMENT_IMPORT_OUTBOX_FIXED_DELAY=2000
DOCUMENT_IMPORT_OUTBOX_INITIAL_DELAY=5000

# ------------------------------------------------------------------------------
# 8. External Integrations
# ------------------------------------------------------------------------------
MERRIAM_WEBSTER_API_KEY=<merriam-webster-collegiate-api-key>
AZURE_TRANSLATOR_KEY=<azure-translator-service-key>
AZURE_TRANSLATOR_REGION=eastus

# ------------------------------------------------------------------------------
# 9. Management, Health, & Monitoring
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
